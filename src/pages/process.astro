---
import BaseLayout from '../layouts/BaseLayout.astro';

// Six stages, taken from how the case-study work actually ran.
// Keep examples short; the case studies tell the full story.
const stages = [
  {
    id: 'understand',
    verb: 'Understand',
    lead: 'Start with the business problem, not the technology.',
    activities: [
      'Go to the floor and watch the work as it happens.',
      'Talk with the people who do it, in meetings and during testing.',
      'Follow how work moves from one team to the next.',
    ],
    example: { text: 'Production team meetings showed why a tracking system gave them little back.', href: '/case-studies/production-tracking-rebuild/', link: 'Production tracking' },
  },
  {
    id: 'define',
    verb: 'Define',
    lead: 'Turn what I saw into something people can act on.',
    activities: [
      'Requirements and clear change requests.',
      'Constraints, risks and who is responsible for what.',
      'What success looks like for the operation.',
    ],
    example: { text: 'Factory feedback grouped into change requests for the developers.', href: '/case-studies/visitor-management/', link: 'Visitor system' },
  },
  {
    id: 'stabilize',
    verb: 'Stabilize',
    lead: 'Keep the operation running while the real fix is prepared.',
    activities: [
      'Find a safe temporary workaround.',
      'Keep interruption to daily work as small as possible.',
      'Plan from the start how the workaround will be removed.',
    ],
    example: { text: 'A temporary Microsoft 365 register kept visitor registration running for about a month.', href: '/case-studies/visitor-management/', link: 'Visitor system' },
  },
  {
    id: 'deliver',
    verb: 'Deliver',
    lead: 'Coordinate the people and the work.',
    activities: [
      'Coordinate developers, vendors and the group IT team.',
      'Configuration, data preparation and testing.',
      'Training and go-live support for users.',
    ],
    example: { text: 'A new factory’s cabling, network and servers, fitted around construction.', href: '/case-studies/factory-it-setup/', link: 'Factory IT set-up' },
  },
  {
    id: 'validate',
    verb: 'Validate',
    lead: 'Does it work for the operation, not only technically?',
    activities: [
      'Test with real users and real workflows.',
      'Re-test after every round of changes.',
      'Give management a clear summary to decide on.',
    ],
    example: { text: 'Factory-side UAT found the gaps before the system went live.', href: '/case-studies/visitor-management/', link: 'Visitor system' },
  },
  {
    id: 'improve',
    verb: 'Improve',
    lead: 'Delivery is not the end of the work.',
    activities: [
      'Collect feedback and document what was done.',
      'Monitor, back up, and test that restores work.',
      'Automate where it helps; retire temporary solutions.',
    ],
    example: { text: 'Daily backups with tested restores; the temporary visitor register retired.', href: '/case-studies/backup-and-recovery/', link: 'Backup and recovery' },
  },
].map((stage, i) => ({ ...stage, num: String(i + 1).padStart(2, '0') }));

const questions = [
  'Does it fit the operation?',
  'Can users work with it?',
  'Is it secure enough for its purpose?',
  'Can IT support it?',
  'What happens when it fails?',
  'Can it be maintained?',
  'Is temporary complexity becoming permanent?',
];
---

<BaseLayout title="Process" description="What happens when Min Hein Zaw receives an IT or business-system problem in manufacturing: understand, define, stabilize, deliver, validate and improve.">
  <section class="page-intro">
    <div class="container">
      <span class="eyebrow">Process</span>
      <h1>What happens when a problem lands on my desk.</h1>
      <p>Six stages I follow on factory IT and business-system work. They come from doing the work, not from a textbook, and each one links to a real case.</p>
      <nav aria-label="Process stages">
        <ol class="pr-flow">
          {stages.map((stage) => <li><a href={`#${stage.id}`}><span>{stage.num}</span>{stage.verb}</a></li>)}
        </ol>
      </nav>
    </div>
  </section>

  <section class="container section" aria-labelledby="stages-title">
    <h2 id="stages-title" class="pr-heading">The six stages</h2>
    <ol class="pr-stages">
      {stages.map((stage) => (
        <li class="pr-stage" id={stage.id}>
          <div class="pr-stage-top"><span class="pr-num">{stage.num}</span><h3>{stage.verb}</h3></div>
          <p class="pr-lead">{stage.lead}</p>
          <ul class="pr-activities">{stage.activities.map((a) => <li>{a}</li>)}</ul>
          <p class="pr-example"><span>In practice</span>{stage.example.text} <a href={stage.example.href}>{stage.example.link} case study <span aria-hidden="true">→</span></a></p>
        </li>
      ))}
    </ol>
  </section>

  <section class="pr-decide" aria-labelledby="decide-title">
    <div class="container pr-decide-inner">
      <div>
        <span class="eyebrow">How I decide</span>
        <h2 id="decide-title">When deciding on a solution, I ask:</h2>
      </div>
      <ol class="pr-questions">
        {questions.map((q) => <li>{q}</li>)}
      </ol>
    </div>
  </section>

  <section class="container section pr-next">
    <p>See the stages in real work.</p>
    <div class="cs-cta-actions">
      <a class="button" href="/case-studies/">View case studies</a>
      <a class="button secondary" href="/contact/">Contact</a>
    </div>
  </section>
</BaseLayout>
