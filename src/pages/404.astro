---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist. Go back to the home page, the case studies or the contact page.">
  <section class="page-intro">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1>This page is not here.</h1>
      <p>The link may be old, or the address may have a typo. These pages are a good place to continue:</p>
      <div class="cs-cta-actions not-found-actions">
        <a class="button" href="/">Home</a>
        <a class="button secondary" href="/case-studies/">Case studies</a>
        <a class="button secondary" href="/contact/">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
