---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import profilePhoto from '../assets/profile.jpg';
import { yearsInIt, experience, vendorSystems, builtSystems, learningBuilds, skills, education, certifications, languages } from '../data/career';

const systemGroups = [
  { title: 'Vendor systems I worked on', items: vendorSystems },
  { title: 'Solutions I built at work', items: builtSystems },
  { title: 'Learning builds', items: learningBuilds },
];

// My path: one chapter per career step, each with what it taught me (owner's own words, 2026-11-04).
const path = [
  { period: '2010 – 2017', role: 'IT Staff, Myanmar Police Organization', text: 'Seven years of running servers, networks and CCTV taught me two things: how much people depend on their systems, and how much depends on good communication.' },
  { period: '2017 – 2018', role: 'IT Assistant, garment factory', text: 'My first job in garment manufacturing, including the warehouse ERP roll-out for barcodes, goods received and issuing.' },
  { period: '2018 – 2019', role: 'Personal Assistant to the Managing Director', text: 'I stepped out of IT on purpose, to learn how a business is run. Once I understood what I needed to, I went back to the work I enjoy most.' },
  { period: '2019 – today', role: 'IT Executive, then IT Manager', text: 'Leading IT for two factories. What I enjoy most now is learning how the whole supply chain works, process by process, and working out how IT can support it and make it digital.' },
];

// How I work: steps taken from what I actually did on the VMS and PTS projects.
const approach = [
  { title: 'Go to the floor', text: 'Talk with the people who do the work, in meetings and during testing.' },
  { title: 'Understand the process', text: 'Follow how the work flows from one team to the next before changing anything.' },
  { title: 'Turn needs into requirements', text: 'Group feedback into clear change requests for developers, vendors or the group IT team.' },
  { title: 'Keep operations running', text: 'If the main system is not ready, put a simple bridge in place, and retire it later.' },
  { title: 'Validate and report', text: 'Re-test with users, and give management a clear summary to decide on.' },
];

const beliefs = [
  { title: 'Technology has to fit the operation.', text: 'A system that works technically but not on the factory floor will be bypassed.', href: '/case-studies/visitor-management/', link: 'Visitor system case study' },
  { title: 'Requirements start at ground level.', text: 'Ask who will use it and how it helps production before anything is built.', href: '/case-studies/production-tracking-rebuild/', link: 'Production tracking case study' },
  { title: 'Keep the business running.', text: 'Use a simple bridge when needed, and retire it once the right long-term solution is ready.', href: '/case-studies/visitor-management/', link: 'Visitor system case study' },
];
---

<BaseLayout title="About" description="Min Hein Zaw, IT Manager for two garment factories in Myanmar: my path into IT, what I believe about technology at work, and my full CV.">
  <section class="page-intro">
    <div class="container">
      <span class="eyebrow">About</span>
      <h1>The work I would choose every time.</h1>
      <p>I have been obsessed with IT since I was young. Other work tires me out; IT work, even on a long day, still makes me happy. Today I am IT Manager for two garment factories in Myanmar, with {yearsInIt} years in IT behind me.</p>
    </div>
  </section>

  <section class="container about-grid">
    <aside class="about-aside">
      <Image class="about-photo" src={profilePhoto} alt="Portrait of Min Hein Zaw" loading="eager" />
      <strong>Min Hein Zaw</strong>
      <p>IT Manager · Garment manufacturing</p>
      <dl class="about-facts">
        <div><dt>In IT</dt><dd>{yearsInIt} years</dd></div>
        <div><dt>Sites</dt><dd>2 factories</dd></div>
        <div><dt>Based in</dt><dd>Myanmar</dd></div>
      </dl>
    </aside>

    <div class="about-main">
      <section class="about-block" aria-labelledby="path-title">
        <span class="eyebrow">01 / My path</span>
        <h2 id="path-title">How I got here</h2>
        <ol class="about-path">
          {path.map((step) => (
            <li>
              <span class="about-path-period">{step.period}</span>
              <div><h3>{step.role}</h3><p>{step.text}</p></div>
            </li>
          ))}
        </ol>
      </section>

      <section class="about-block" aria-labelledby="work-title">
        <span class="eyebrow">02 / How I work</span>
        <h2 id="work-title">Between the business and the technology</h2>
        <p class="about-lead">Most of my work is translation: understanding what the factory needs, and making sure the people who build or supply systems understand it too.</p>
        <ol class="about-bridge" aria-label="Who I connect">
          <li><strong>Business &amp; factory users</strong><span>Every production department, from merchandising to delivery, and management</span></li>
          <li class="about-bridge-link" aria-hidden="true"><span>needs</span><span>feedback</span></li>
          <li class="about-bridge-me"><strong>IT — my role</strong><span>Translate, coordinate, keep things running</span></li>
          <li class="about-bridge-link" aria-hidden="true"><span>requirements</span><span>testing</span></li>
          <li><strong>Developers &amp; vendors</strong><span>The group’s IT team and outside vendors</span></li>
        </ol>
        <h3 class="about-subhead">How I approach a problem</h3>
        <ol class="about-approach">
          {approach.map((step, i) => (
            <li><span class="about-approach-num">{String(i + 1).padStart(2, '0')}</span><div><strong>{step.title}</strong><p>{step.text}</p></div></li>
          ))}
        </ol>
      </section>

      <section class="about-block" aria-labelledby="beliefs-title">
        <span class="eyebrow">03 / What I believe</span>
        <h2 id="beliefs-title">Three things I hold on to</h2>
        <ul class="about-beliefs">
          {beliefs.map((belief) => (
            <li>
              <h3>{belief.title}</h3>
              <p>{belief.text}</p>
              <a class="text-link" href={belief.href}>{belief.link} <span aria-hidden="true">↗</span></a>
            </li>
          ))}
        </ul>
      </section>

      <section class="about-block" aria-labelledby="beyond-title">
        <span class="eyebrow">04 / Beyond the job</span>
        <h2 id="beyond-title">Teaching and learning</h2>
        <div class="about-beyond">
          <div>
            <h3>Why I teach</h3>
            <p>I learned IT the hard way, without much money, and getting onto this path was not easy. Since 2018 I have taught Microsoft Office, PageMaker and Photoshop part-time, so that people who start where I started can learn IT more easily than I did.</p>
          </div>
          <div>
            <h3>Still learning</h3>
            <p>I am studying for a Higher Diploma in Computer Science, working on more certifications, and trying new tools in my own <a class="inline-link" href="/projects/#lab-title">lab builds</a>.</p>
          </div>
        </div>
      </section>

      <details class="about-cv" id="cv">
        <summary><span class="about-cv-text"><span class="eyebrow">05 / Full CV</span><span class="about-cv-title">Experience, systems, skills, education and languages</span></span></summary>
        <div class="about-cv-body">
          <section class="about-block" aria-labelledby="experience-title">
            <h2 id="experience-title">Experience</h2>
            <ol class="timeline">
              {experience.map((job) => (
                <li class="timeline-item">
                  <div class="timeline-period">{job.period}</div>
                  <div>
                    <h3>{job.steps ? job.org : job.title}</h3>
                    <p class="timeline-org">{job.steps ? job.place : `${job.org} · ${job.place}`}</p>
                    {job.steps && (
                      <ul class="role-steps">
                        {job.steps.map((step) => <li><strong>{step.title}</strong> <span>{step.org} · {step.period}</span></li>)}
                      </ul>
                    )}
                    <ul class="timeline-points">{job.points.map((point) => <li>{point}</li>)}</ul>
                  </div>
                </li>
              ))}
            </ol>
          </section>
    
          <section class="about-block" aria-labelledby="systems-title">
            <h2 id="systems-title">Systems I've worked on</h2>
            {systemGroups.map((group) => (
              <div class="system-group">
                <h3>{group.title}</h3>
                <ul class="system-list">
                  {group.items.map((item) => (
                    <li>
                      <span class="system-name">{item.name}{item.status && <span class="status-tag">{item.status}</span>}</span>
                      {item.note && <span class="system-note">{item.note}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </section>
    
          <section class="about-block" aria-labelledby="skills-title">
            <h2 id="skills-title">Skills</h2>
            <div class="skill-groups">
              {skills.map((group) => (
                <div class="skill-group">
                  <h3>{group.group}</h3>
                  <ul class="tag-list">{group.items.map((item) => <li>{item}</li>)}</ul>
                </div>
              ))}
            </div>
          </section>
    
          <section class="about-block" aria-labelledby="education-title">
            <h2 id="education-title">Education &amp; certifications</h2>
            <div class="cred-columns">
              <div>
                <h3>Education</h3>
                <ul class="cred-list">
                  {education.map((item) => <li><strong>{item.name}</strong><span>{item.org} · {item.status}</span></li>)}
                </ul>
              </div>
              <div>
                <h3>Certifications — completed</h3>
                <ul class="cred-list">
                  {certifications.done.map((item) => <li><strong>{item.name}</strong>{item.org && <span>{item.org}</span>}</li>)}
                </ul>
                <h3>Certifications — in progress</h3>
                <ul class="cred-list">
                  {certifications.inProgress.map((item) => <li><strong>{item.name}</strong></li>)}
                </ul>
              </div>
            </div>
          </section>
    
          <section class="about-block" aria-labelledby="languages-title">
            <h2 id="languages-title">Languages</h2>
            <ul class="cred-list cred-inline">
              {languages.map((item) => <li><strong>{item.name}</strong><span>{item.level}</span></li>)}
            </ul>
          </section>
        </div>
      </details>
    </div>
  </section>
</BaseLayout>
