---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const studies = await getCollection('case-studies');
  return studies.map((study) => ({ params: { slug: study.id }, props: { study } }));
}

const { study } = Astro.props;
const { Content } = await render(study);
---

<BaseLayout title={study.data.title} description={study.data.summary}>
  <section class="page-intro"><div class="container"><a class="back-link" href="/case-studies/">← All case studies</a><span class="eyebrow" style="margin-top: 24px">Case study</span><h1>{study.data.title}</h1><p>{study.data.summary}</p><div class="case-meta"><span>Role / {study.data.role}</span><span>Duration / {study.data.duration}</span></div></div></section>
  <article class="container content-section">
    <div class="results-grid">{study.data.results.map((result) => <div class="result-item">{result}</div>)}</div>
    <div class="prose case-content"><Content /></div>
    <a class="back-link" href="/case-studies/">← Back to all case studies</a>
  </article>
</BaseLayout>