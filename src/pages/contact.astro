---
import BaseLayout from '../layouts/BaseLayout.astro';

// Web3Forms public form key (PUBLIC_ by design, restricted to the live domain in the
// Web3Forms dashboard). Read from .env, never hard-coded.
const accessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? '';
const email = 'mr.munheinzaw1992@gmail.com';
---

<BaseLayout title="Contact" description="Contact Min Hein Zaw about IT operations, infrastructure, business systems and Microsoft 365 in manufacturing.">
  <section class="page-intro">
    <div class="container">
      <span class="eyebrow">Contact</span>
      <h1>Let’s talk about practical IT.</h1>
      <p>If you’d like to discuss IT operations, business systems or practical technology improvement, feel free to get in touch.</p>
    </div>
  </section>

  <section class="container contact-grid">
    <div class="contact-details">
      <h2>Ways to reach me</h2>
      <dl class="contact-options">
        <div>
          <dt>Email</dt>
          <dd><a class="text-link contact-email" href={`mailto:${email}`}>{email}</a></dd>
        </div>
        <div>
          <dt>Freelance</dt>
          <dd>Open to small projects: PC and laptop set-up, Microsoft 365, network and cabling, and servers. I can also help you find where AI fits into everyday workflows.</dd>
        </div>
      </dl>
      <div class="contact-note">Myanmar / Garment manufacturing / IT operations</div>
    </div>

    <form action="https://api.web3forms.com/submit" method="POST" aria-describedby="form-required">
      <input type="hidden" name="access_key" value={accessKey} />
      <input type="hidden" name="from_name" value="Portfolio contact form" />
      <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <p class="form-required" id="form-required">All fields are required.</p>
      <div class="form-grid">
        <div class="field"><label for="name">Name</label><input id="name" name="name" autocomplete="name" maxlength="100" required /></div>
        <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" inputmode="email" autocomplete="email" maxlength="150" required aria-describedby="email-hint" /><span class="field-hint" id="email-hint">So I can reply to you.</span></div>
        <div class="field full"><label for="subject">Subject</label><input id="subject" name="subject" maxlength="150" required /></div>
        <div class="field full"><label for="message">Message</label><textarea id="message" name="message" maxlength="3000" required></textarea></div>
      </div>
      <div class="form-footer"><button class="button" type="submit">Send message <span aria-hidden="true">→</span></button></div>
      <p class="form-privacy">This form is handled by Web3Forms, a third-party service. Your name, email, subject and message are sent to Web3Forms and forwarded to me by email; nothing is stored on this site. After sending, Web3Forms shows a confirmation page.</p>
      {!accessKey && <p class="sample-notice" role="status">Contact form is not configured yet. Add your Web3Forms key to <code>.env</code> before deployment.</p>}
    </form>
  </section>
</BaseLayout>
