---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Message sent" description="Your message was sent. Thank you for getting in touch." noindex>
  <section class="page-intro">
    <div class="container">
      <span class="eyebrow">Message sent</span>
      <h1>Thank you. Your message reached me.</h1>
      <p>I’ll reply to the email you gave as soon as I can.</p>
      <div class="cs-cta-actions not-found-actions">
        <a class="button" href="/case-studies/">Read case studies</a>
        <a class="button secondary" href="/">Back to home</a>
      </div>
    </div>
  </section>
</BaseLayout>
