---
import BaseLayout from '../layouts/BaseLayout.astro';
import { builtAtWork, coordinated, learning, retired, type Status } from '../data/projects';

const groups = [
  { id: 'built', num: '01', eyebrow: 'Built at work', title: 'Tools I built for the factories.', note: 'I built these myself, for use at work.', items: builtAtWork },
  { id: 'coordinated', num: '02', eyebrow: 'Implemented or coordinated', title: 'Systems I helped bring into use.', note: 'Built by the group’s developers or bought from vendors. My part was requirements, UAT, coordination and rollout support, not development.', items: coordinated },
  { id: 'lab', num: '03', eyebrow: 'Learning builds', title: 'Where I try new tools.', note: 'Personal prototypes and experiments. Not production systems.', items: learning },
  { id: 'retired', num: '04', eyebrow: 'Retired', title: 'Done its job.', note: 'Solutions that were needed for a time and then removed.', items: retired },
].filter((group) => group.items.length > 0);

const statusClass = (status: Status) => `pj-status pj-status-${status.toLowerCase().replace(/\s+/g, '-')}`;
---

<BaseLayout title="Projects" description="What Min Hein Zaw built at work, which factory systems he implemented or coordinated, his learning builds, and retired interim solutions.">
  <section class="page-intro">
    <div class="container">
      <span class="eyebrow">Projects</span>
      <h1>What I built, what I coordinated, what I’m learning.</h1>
      <p>Every project says who built it and what my part was. Systems built by the group’s developers or bought from vendors are marked as coordinated, not as my own work.</p>
      <nav aria-label="Project groups">
        <ol class="pj-jump">
          {groups.map((group) => <li><a href={`#${group.id}`}><span>{group.num}</span>{group.eyebrow}</a></li>)}
        </ol>
      </nav>
    </div>
  </section>

  {groups.map((group) => (
    <section class="container section project-section pj-section" id={group.id} aria-labelledby={`${group.id}-title`}>
      <div class="section-heading"><div><span class="eyebrow">{group.num} / {group.eyebrow}</span><h2 id={`${group.id}-title`}>{group.title}</h2><p class="project-note">{group.note}</p></div></div>
      <div class="project-grid">
        {group.items.map((project) => (
          <article class:list={['project-card', 'pj-card', { 'pj-card-linked': project.link }]}>
            <div class="pj-card-head">
              <div class="pj-labels"><span class="pj-kind">{project.kind}</span>{project.status && <span class={statusClass(project.status)}>{project.status}</span>}</div>
              <h3>{project.title}</h3>
              {project.builtBy && <p class="pj-builtby">{project.builtBy}</p>}
              {project.tech && <p class="pj-tech"><span>Technology</span>{project.tech.join(' · ')}</p>}
            </div>
            <div class="pj-card-body">
              <dl class="pj-facts">
                <div><dt>{project.need.label}</dt><dd>{project.need.text}</dd></div>
                <div><dt>My contribution</dt><dd>{project.contribution}</dd></div>
              </dl>
              {project.link && <a class="text-link pj-link" href={project.link.href}>{project.link.label} <span aria-hidden="true">→</span></a>}
            </div>
          </article>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
