---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSortedCaseStudies } from '../lib/case-studies';
import SdlcWheel from '../components/SdlcWheel.astro';
import { ecosystem, timeline, certifications, yearsInIt } from '../data/career';
import heroImage from '../assets/home/hero-network.jpg';

const caseStudies = await getSortedCaseStudies();
const featured = caseStudies.slice(0, 2);
const focusAreas = ['Infrastructure', 'Cybersecurity', 'Microsoft 365', 'Business Systems', 'Automation'];
// Simple line icons (24 x 24, stroked).
const expertise = [
  { label: 'Infrastructure', note: 'Servers · ESXi · Network · CCTV', icon: 'M4 4h16v6H4zM4 14h16v6H4zM8 7h.01M8 17h.01' },
  { label: 'Security & Backup', note: 'Backups · Accounts · Access', icon: 'M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6zM9 12l2 2 4-4' },
  { label: 'Microsoft 365', note: 'Exchange · SharePoint · Licences', icon: 'M4 4h7v7H4zM13 4h7v7h-7zM4 13h7v7H4zM13 13h7v7h-7z' },
  { label: 'Business Systems', note: 'ERP · Payroll · Planning · UAT', icon: 'M3 5h18v12H3zM8 21h8M12 17v4M7 13l3-3 3 2 4-4' },
  { label: 'Automation', note: 'Power Automate · n8n · AI', icon: 'M13 2L4 14h7l-1 8 9-12h-7z' },
];
// Only confirmed figures. Add more when real numbers are available.
const stats = [
  { value: yearsInIt, label: 'Years in IT' },
  { value: '2', label: 'Garment factories supported' },
];
---

<BaseLayout title="Home" description="Min Hein Zaw, IT Manager for two garment factories in Myanmar: infrastructure, Microsoft 365, business systems and automation.">
  <section class="hero">
    <Image class="hero-bg" src={heroImage} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="container hero-grid">
      <div class="hero-inner">
        <span class="eyebrow">Min Hein Zaw / IT Manager / Myanmar</span>
        <h1><span class="hero-line">Curious by nature.</span> <span class="hero-line"><em>IT</em> by choice.</span></h1>
        <p class="hero-copy">I’m Min Hein Zaw, and I genuinely love making technology work: networks, systems, security, the 2 a.m. fix and the long-term plan. Most of my work has been in manufacturing, where reliable IT keeps people and production moving.</p>
        <ul class="hero-focus" aria-label="Focus areas">
          {focusAreas.map((area) => <li>{area}</li>)}
        </ul>
        <div class="hero-actions">
          <a class="button" href="/case-studies/">View my work <span aria-hidden="true">→</span></a>
          <a class="button secondary" href="/contact/">Let’s talk <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <a class="hero-wheel" href="/process/" aria-label="My delivery process: seven SDLC stages">
        <SdlcWheel />
      </a>
    </div>

    <div class="container hero-lower" id="expertise">
      <h2 class="visually-hidden">What I look after</h2>
      <ul class="expertise-cards">
        {expertise.map((item) => (
          <li>
            <a class="expertise-card" href="/about/#skills-title">
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={item.icon} /></svg>
              <strong>{item.label}</strong>
              <span>{item.note}</span>
            </a>
          </li>
        ))}
      </ul>
      <dl class="hero-stats">
        {stats.map((stat) => <div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>)}
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="container split-layout">
      <div>
        <span class="eyebrow">Philosophy</span>
        <h2>IT should make the workday more dependable.</h2>
        <p class="split-copy">In garment manufacturing, a network issue is never just a network issue. It can interrupt a line, delay a shipment or leave a team without the information they need. I build technology operations around those real-world stakes.</p>
        <a class="text-link" href="/about/">More about me <span aria-hidden="true">↗</span></a>
      </div>
      <ul class="focus-list">
        <li><span class="focus-number">01</span><div><strong>Stable foundations</strong><p>Networks, endpoints, identity and infrastructure engineered for the factory floor.</p></div></li>
        <li><span class="focus-number">02</span><div><strong>Useful systems</strong><p>Business and production platforms that support clear, timely decisions.</p></div></li>
        <li><span class="focus-number">03</span><div><strong>Capable teams</strong><p>Practical governance, clear ownership and calm incident response.</p></div></li>
      </ul>
    </div>
  </section>

  <section class="section" style="padding-top: 8px">
    <div class="container">
      <div class="section-heading"><div><span class="eyebrow">Selected work</span><h2>Case studies</h2></div><a class="text-link" href="/case-studies/">All case studies <span aria-hidden="true">↗</span></a></div>
      {featured.length ? (
        <div class="case-grid">
          {featured.map((study, index) => (
            <a class="case-card" href={`/case-studies/${study.id}/`}>
              <div class="card-topline"><span>Case study / {study.data.duration}</span><span class="card-index">0{index + 1}</span></div>
              <h3>{study.data.title}</h3>
              <p>{study.data.summary}</p>
              <ul class="tag-list">{study.data.tags.map((tag) => <li>{tag}</li>)}</ul>
              <span class="text-link">Read case study <span aria-hidden="true">↗</span></span>
            </a>
          ))}
        </div>
      ) : <p class="empty-state">The first case study is in progress.</p>}
    </div>
  </section>

  <section class="section eco-section" aria-labelledby="ecosystem-title">
    <div class="container">
      <div class="section-heading"><div><span class="eyebrow">Technology ecosystem</span><h2 id="ecosystem-title">Tools and systems I work with.</h2></div></div>
      <div class="eco-grid">
        {ecosystem.map((group) => (
          <div class="eco-col">
            <h3>{group.group}</h3>
            <ul class="tag-list">{group.items.map((item) => <li>{item}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="process-band">
    <div class="container">
      <div class="section-heading"><div><span class="eyebrow">How I work</span><h2>Understand, stabilize, deliver, improve.</h2></div><a class="text-link" href="/process/">See the process <span aria-hidden="true">↗</span></a></div>
      <div class="process-steps">
        <div class="process-step"><span>01 / Understand</span><h3>Start at the line</h3><p>Learn the operating context and hear from the people doing the work.</p></div>
        <div class="process-step"><span>02 / Stabilize</span><h3>Protect continuity</h3><p>Address critical risks and make ownership visible.</p></div>
        <div class="process-step"><span>03 / Deliver</span><h3>Ship in phases</h3><p>Make considered changes with measurable acceptance criteria.</p></div>
        <div class="process-step"><span>04 / Improve</span><h3>Learn and adapt</h3><p>Review outcomes, support teams and keep improving.</p></div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="experience-title">
    <div class="container">
      <div class="section-heading"><div><span class="eyebrow">Experience</span><h2 id="experience-title">Career timeline</h2></div><a class="text-link" href="/about/">Full experience <span aria-hidden="true">↗</span></a></div>
      <ol class="home-timeline">
        {timeline.map((row) => (
          <li><span class="home-timeline-period">{row.period}</span><strong>{row.title}</strong><span class="home-timeline-org">{row.org}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section certs-section" aria-labelledby="certs-title">
    <div class="container">
      <div class="section-heading"><div><span class="eyebrow">Certifications</span><h2 id="certs-title">Always learning.</h2></div><a class="text-link" href="/about/#education-title">Education &amp; certifications <span aria-hidden="true">↗</span></a></div>
      <div class="cred-columns">
        <div>
          <h3>Completed</h3>
          <ul class="cred-list">{certifications.done.map((item) => <li><strong>{item.name}</strong></li>)}</ul>
        </div>
        <div>
          <h3>In progress</h3>
          <ul class="cred-list">{certifications.inProgress.map((item) => <li><strong>{item.name}</strong></li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="container section" style="padding-top: 52px; padding-bottom: 52px">
    <div class="cta-band"><p>Let’s build better systems.</p><a class="button" href="/contact/">Get in touch <span aria-hidden="true">↗</span></a></div>
  </section>
</BaseLayout>
