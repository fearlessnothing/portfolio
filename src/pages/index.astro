---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CaseStudyCard from '../components/CaseStudyCard.astro';
import { getSortedCaseStudies } from '../lib/case-studies';
import heroImage from '../assets/home/hero-denim.jpg';
import infrastructureImage from '../assets/home/expertise-infrastructure.jpg';
import securityImage from '../assets/home/expertise-security.jpg';
import m365Image from '../assets/home/expertise-m365.jpg';
import businessImage from '../assets/home/expertise-business.jpg';
import automationImage from '../assets/home/expertise-automation.jpg';

const caseStudies = await getSortedCaseStudies();
// Home shows only the flagship case studies; the rest live on /case-studies/.
const featured = caseStudies.filter((study) => study.data.featured).slice(0, 2);
// Same five names as the expertise hexagons below.
const focusAreas = ['Infrastructure', 'Security & Backup', 'Microsoft 365', 'Business Systems', 'Automation'];
const steps = [
  { id: 'understand', verb: 'Understand' },
  { id: 'define', verb: 'Define' },
  { id: 'stabilize', verb: 'Stabilize' },
  { id: 'deliver', verb: 'Deliver' },
  { id: 'validate', verb: 'Validate' },
  { id: 'improve', verb: 'Improve' },
];
const expertise = [
  { label: 'Infrastructure', note: 'Servers · ESXi · Network · CCTV', image: infrastructureImage },
  { label: 'Security & Backup', note: 'Backups · Accounts · Access', image: securityImage },
  { label: 'Microsoft 365', note: 'Exchange · SharePoint · Licences', image: m365Image },
  { label: 'Business Systems', note: 'ERP · Payroll · Planning · UAT', image: businessImage },
  { label: 'Automation', note: 'Power Automate · n8n · AI', image: automationImage },
];
---

<BaseLayout title="Home" description="Min Hein Zaw, IT Manager for two garment factories in Myanmar: infrastructure, security, Microsoft 365, business systems and digital improvement.">
  <section class="hero">
    <Image class="hero-bg" src={heroImage} alt="" widths={[800, 1400, 2000]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="container hero-inner">
      <span class="eyebrow">IT Manager / Garment manufacturing</span>
      <h1><span class="hero-line">Curious by nature.</span> <span class="hero-line"><em>IT</em> by choice.</span></h1>
      <p class="hero-copy">I’m Min Hein Zaw, IT Manager for two garment factories in Myanmar. I look after the infrastructure and business systems that keep people and production moving, and I love making technology work.</p>
      <div class="hero-actions">
        <a class="button" href="/case-studies/">View case studies <span aria-hidden="true">→</span></a>
        <a class="button secondary" href="/projects/">Explore projects <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <div class="focus-strip">
    <ul class="container" aria-label="Focus areas">
      {focusAreas.map((area) => <li>{area}</li>)}
    </ul>
  </div>

  <section class="explore" id="expertise" aria-labelledby="expertise-title">
    <div class="container">
      <div class="explore-heading"><span class="eyebrow">Expertise</span><h2 id="expertise-title">What I look after.</h2></div>
      <div class="expertise-grid">
        {expertise.map((item, i) => (
          <a class="expertise-card" href="/about/#skills-title">
            <Image src={item.image} alt="" widths={[400, 800]} sizes="(max-width: 480px) 100vw, (max-width: 920px) 50vw, 33vw" />
            <span class="expertise-num">0{i + 1}</span>
            <span class="expertise-title">{item.label}</span>
            <span class="expertise-note">{item.note}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="philosophy-title">
    <div class="container split-layout">
      <div>
        <span class="eyebrow">Philosophy</span>
        <h2 id="philosophy-title">IT should make the workday more dependable.</h2>
      </div>
      <div class="home-philosophy">
        <p class="split-copy">In manufacturing, a network, system or information problem is never only technical. It can stop a line, delay a shipment or leave a team without what it needs to decide.</p>
        <a class="text-link" href="/about/">More about me <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section home-featured" aria-labelledby="featured-title">
    <div class="container">
      <div class="section-heading"><div><span class="eyebrow">Featured case studies</span><h2 id="featured-title">Real problems, worked through.</h2></div><a class="text-link" href="/case-studies/">All case studies <span aria-hidden="true">→</span></a></div>
      {featured.length ? (
        <div class="case-grid">
          {featured.map((study, index) => <CaseStudyCard study={study} number={index + 1} variant="home" />)}
        </div>
      ) : <p class="empty-state">The first case study is in progress.</p>}
    </div>
  </section>

  <section class="process-band" aria-labelledby="how-title">
    <div class="container">
      <div class="section-heading"><div><span class="eyebrow">How I work</span><h2 id="how-title">Six stages, from the floor up.</h2></div><a class="text-link" href="/process/">See my process <span aria-hidden="true">→</span></a></div>
      <nav aria-label="Process stages">
        <ol class="pr-flow home-flow">
          {steps.map((step, i) => <li><a href={`/process/#${step.id}`}><span>0{i + 1}</span>{step.verb}</a></li>)}
        </ol>
      </nav>
    </div>
  </section>

  <section class="container section home-cta">
    <div class="cta-band"><p>Let’s build better systems.</p><a class="button" href="/contact/">Get in touch <span aria-hidden="true">→</span></a></div>
  </section>
</BaseLayout>
