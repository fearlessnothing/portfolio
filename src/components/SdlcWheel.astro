---
// Decorative SDLC wheel. Hidden from screen readers: pages that use it must
// also show the stages as text (Process page list, or a link to it).
import { sdlcStages } from '../data/sdlc';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;

const center = 300;
const radius = 215;
const step = 360 / sdlcStages.length;
const toRad = (deg: number) => (deg * Math.PI) / 180;
const point = (deg: number) => ({ x: (center + radius * Math.cos(toRad(deg))).toFixed(1), y: (center + radius * Math.sin(toRad(deg))).toFixed(1) });
const nodes = sdlcStages.map((stage, i) => ({ ...stage, num: String(i + 1).padStart(2, '0'), ...point(-90 + i * step) }));
const arrows = sdlcStages.map((_, i) => {
  const angle = -90 + (i + 0.5) * step;
  return { ...point(angle), rotate: (angle + 90).toFixed(1) };
});
---

<svg class:list={['sdlc-wheel', className]} viewBox="0 0 600 600" aria-hidden="true" focusable="false">
  <circle class="wheel-ring" cx={center} cy={center} r={radius} />
  {arrows.map((a) => <path class="wheel-arrow" d="M -7 -7 L 8 0 L -7 7 Z" transform={`translate(${a.x} ${a.y}) rotate(${a.rotate})`} />)}
  <circle class="wheel-core" cx={center} cy={center} r="112" />
  <text class="wheel-core-label" x={center} y="282">SDLC</text>
  <text class="wheel-core-sub" x={center} y="318">Idea to impact</text>
  {nodes.map((n) => (
    <g transform={`translate(${n.x} ${n.y})`}>
      <rect class="wheel-node" x="-80" y="-30" width="160" height="60" rx="30" />
      <text class="wheel-num" x="0" y="-5">{n.num}</text>
      <text class="wheel-name" x="0" y="18">{n.name}</text>
    </g>
  ))}
</svg>
